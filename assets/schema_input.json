{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/mattarnoldbio/viral_metagenomics_lite_ont/master/assets/schema_input.json",
    "title": "mattarnoldbio/viral_metagenomics_lite_ont pipeline - params.input schema",
    "description": "Schema for the file provided with params.input",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "sample": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample name must be provided and cannot contain spaces",
                "meta": ["id"]
            },
            "fastq_dir": {
                "type": "string",
                "format": "directory-path",
                "exists": true,
                "description": "Directory containing this sample's FASTQ files."
            }
        },
        "required": ["sample", "fastq_dir"],
        "additionalProperties": false
    }
}
